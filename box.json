{
    "schema": "https://box-project.github.io/box2/schema.json",
    "main": "bin/app.php",
    "output": "dist/index.php",
    "stub": false,
    "banner": false,
    "php-scoper-config": null,
    "directories": [
        "src",
        "templates"
    ],
    "files": [
        "bin/app.php"
    ],
    "finder": [
        {
            "name": "*.php",
            "in": "vendor",
            "exclude": [
                "Tests",
                "tests",
                "test",
                "docs",
                "doc"
            ]
        }
    ],
    "compression": "NONE",
    "dump-autoload": true,
    "exclude-composer-files": false
}
