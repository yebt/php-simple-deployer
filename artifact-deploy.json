[
  {
    "name": "Show extracted files",
    "run": "ls -la"
  },
  {
    "name": "Frontend: Install dependencies",
    "when": "[ \"$DEPLOY_TYPE\" = 'frontend' ]",
    "run": "echo '[frontend] npm ci --prefer-offline (simulated)'"
  },
  {
    "name": "Frontend: Build",
    "when": "[ \"$DEPLOY_TYPE\" = 'frontend' ]",
    "run": "echo '[frontend] npm run build (simulated)'"
  },
  {
    "name": "Frontend: Copy to web root",
    "when": "[ \"$DEPLOY_TYPE\" = 'frontend' ]",
    "run": "echo '[frontend] rsync dist/ /var/www/html/ (simulated)'"
  },
  {
    "name": "Backend: Install dependencies",
    "when": "[ \"$DEPLOY_TYPE\" = 'backend' ]",
    "run": "echo '[backend] composer install --no-dev (simulated)'"
  },
  {
    "name": "Backend: Run migrations",
    "when": "[ \"$DEPLOY_TYPE\" = 'backend' ]",
    "run": "echo '[backend] php artisan migrate --force (simulated)'"
  },
  {
    "name": "Backend: Restart workers",
    "when": "[ \"$DEPLOY_TYPE\" = 'backend' ]",
    "run": "echo '[backend] php artisan queue:restart (simulated)'"
  },
  {
    "name": "Common: Verify deploy",
    "run": "echo '[common] deploy finished for type: $DEPLOY_TYPE'"
  }
]
