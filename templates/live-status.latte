{**
 * Live deployment status page — /status/live
 *
 * Standalone page (no layout). Streams /status/stream via SSE.
 *
 * Params:
 *   string $dashboardUrl  — URL to the dashboard (e.g. /health2)
 *   string $currentTask   — initial task name from status file
 *   int    $index         — initial task index
 *   int    $total         — total tasks
 *   string $logFile       — current log file name (for View Log link after done)
 **}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Deploying…</title>
    <script src="https://unpkg.com/@tailwindcss/browser@4"></script>
    <style>
        @font-face {
            font-family: 'JetBrains Mono Variable';
            font-style: normal;
            font-display: swap;
            font-weight: 100 800;
            src: url(https://cdn.jsdelivr.net/fontsource/fonts/jetbrains-mono:vf@latest/latin-wght-normal.woff2) format('woff2-variations');
        }
    </style>
    <style type="text/tailwindcss">
        @theme {
            --font-mono: "JetBrains Mono Variable", ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
        }

        .task-row { @apply border border-slate-800 rounded-lg overflow-hidden transition-all duration-200; }
        .task-row.is-running { @apply border-blue-500/40 bg-blue-500/5; }
        .task-row.is-failed  { @apply border-rose-500/30 bg-rose-500/5; }
        .task-row.is-success { @apply border-emerald-500/20; }

        .badge-wait    { @apply bg-slate-800 text-slate-500; }
        .badge-running { @apply bg-blue-500/15 text-blue-400 border border-blue-500/40; }
        .badge-success { @apply bg-emerald-500/15 text-emerald-400; }
        .badge-failed  { @apply bg-rose-500/15 text-rose-400; }

        @keyframes pulse-bar {
            0%, 100% { opacity: 1; }
            50%       { opacity: 0.6; }
        }
        .bar-running { animation: pulse-bar 2s ease-in-out infinite; }
    </style>
</head>

<body class="bg-[#080c14] text-slate-400 min-h-screen font-mono antialiased">

    {* ── Top bar ──────────────────────────────────────────────────────────── *}
    <header class="border-b border-slate-800 px-6 py-3 flex items-center justify-between">
        <div class="flex items-center gap-3">
            <span class="w-2 h-2 rounded-full bg-blue-500 animate-pulse" id="pulse-dot"></span>
            <span class="text-[10px] uppercase tracking-[0.25em] text-slate-500">Live Deploy</span>
        </div>
        <a href="{$dashboardUrl}" class="text-[10px] uppercase tracking-widest text-slate-600 hover:text-slate-300 transition">
            ← Exit
        </a>
    </header>

    <main class="max-w-5xl mx-auto px-6 py-8 space-y-6">

        {* ── Current task + progress ──────────────────────────────────────── *}
        <section>
            <p class="text-[10px] uppercase tracking-[0.2em] text-slate-600 mb-1">Running</p>
            <h1 id="current-task" class="text-xl text-white font-bold tracking-tight truncate mb-4">
                {$currentTask|noescape}
            </h1>

            <div class="flex items-center gap-3">
                <div class="flex-1 h-1.5 bg-slate-800 rounded-full overflow-hidden">
                    <div id="progress-bar"
                         class="h-full bg-blue-500 rounded-full transition-all duration-500 bar-running"
                         style="width:0%">
                    </div>
                </div>
                <span id="progress-text" class="text-[11px] font-bold text-slate-500 tabular-nums w-12 text-right">
                    0/0
                </span>
            </div>
        </section>

        {* ── Result banner (hidden until done) ───────────────────────────── *}
        <div id="result-banner" class="hidden"></div>

        {* ── Two columns: task list + terminal ───────────────────────────── *}
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">

            {* Task list *}
            <div class="flex flex-col gap-2">
                <p class="text-[10px] uppercase tracking-[0.2em] text-slate-600 mb-1">Tasks</p>
                <div id="task-list" class="space-y-1.5 overflow-y-auto max-h-[26rem] pr-1">
                    <p class="text-[10px] text-slate-700 italic">Waiting for first update…</p>
                </div>
            </div>

            {* Output terminal *}
            <div class="flex flex-col gap-2">
                <p class="text-[10px] uppercase tracking-[0.2em] text-slate-600 mb-1">Output</p>
                <pre id="output-terminal"
                     class="flex-1 h-[26rem] overflow-y-auto p-4 bg-slate-950 text-slate-300 text-[10px]
                            rounded-lg border border-slate-800 font-mono whitespace-pre-wrap break-words
                            leading-relaxed"></pre>
            </div>

        </div>

        {* ── Footer actions ──────────────────────────────────────────────── *}
        <footer class="flex items-center justify-between pt-4 border-t border-slate-800">
            <p id="status-text" class="text-[9px] uppercase tracking-widest text-slate-700 italic animate-pulse">
                Connecting…
            </p>
            <div id="action-buttons" class="flex items-center gap-3">
                <button id="stop-button"
                        onclick="stopDeployment()"
                        class="hidden items-center gap-2 bg-rose-600 hover:bg-rose-500 text-white
                               px-4 py-2 rounded text-[10px] font-bold uppercase tracking-widest transition">
                    &#9209; Stop
                </button>
            </div>
        </footer>

    </main>

    <div id="app-config"
         data-dashboard-url="{$dashboardUrl}"
         data-log-file="{$logFile}"
         hidden></div>

    <script>
        // ── Bootstrap ────────────────────────────────────────────────────────
        var _cfg         = document.getElementById('app-config').dataset;
        var dashboardUrl = _cfg.dashboardUrl;
        var logFile      = _cfg.logFile || '';

        // Task state
        var taskOutputs  = {};   // { [name]: string }  — completed output only
        var taskOrder    = [];   // ordered names
        var taskStatus   = {};   // { [name]: 'pending'|'running'|'success'|'failed' }
        var currentTask  = '';
        var liveOutput   = '';   // output of the currently running task (terminal only)
        var initialized  = false;

        // ── Helpers ──────────────────────────────────────────────────────────

        function escapeHtml(str) {
            return String(str)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;');
        }

        function badgeFor(status) {
            var map = {
                success: ['DONE', 'badge-success'],
                failed:  ['FAIL', 'badge-failed'],
                running: ['BUSY', 'badge-running']
            };
            return map[status] || ['WAIT', 'badge-wait'];
        }

        function rowClassFor(status) {
            var map = { running: 'is-running', failed: 'is-failed', success: 'is-success' };
            return map[status] || '';
        }

        // ── Initialize task slots from task_names list ────────────────────────

        function initTasks(names) {
            if (initialized || !names || names.length === 0) return;
            initialized = true;
            names.forEach(function(name) {
                if (!taskOutputs.hasOwnProperty(name)) {
                    taskOrder.push(name);
                    taskStatus[name]  = 'pending';
                    taskOutputs[name] = '';
                }
            });
            renderTasks();
        }

        // ── Task list render ─────────────────────────────────────────────────

        function renderTasks() {
            var container = document.getElementById('task-list');
            if (taskOrder.length === 0) return;

            container.innerHTML = '';
            taskOrder.forEach(function(name, i) {
                var status    = taskStatus[name] || 'pending';
                var output    = (status === 'success' || status === 'failed') ? taskOutputs[name] : '';
                var pair      = badgeFor(status);
                var label     = pair[0];
                var badgeClass = pair[1];
                var rowClass  = rowClassFor(status);
                var toggleId  = 'task-output-' + i;
                var nameClass = status === 'running'
                    ? 'text-white font-bold'
                    : (status === 'pending' ? 'text-slate-600' : 'text-slate-400');

                var bounceDots = '';
                if (status === 'running') {
                    bounceDots = '<span class="flex gap-0.5 ml-1">'
                        + '<span class="w-1 h-1 bg-blue-400 rounded-full animate-bounce"></span>'
                        + '<span class="w-1 h-1 bg-blue-400 rounded-full animate-bounce [animation-delay:0.15s]"></span>'
                        + '<span class="w-1 h-1 bg-blue-400 rounded-full animate-bounce [animation-delay:0.3s]"></span>'
                        + '</span>';
                }

                var existingEl = document.getElementById(toggleId);
                var wasOpen = existingEl
                    ? !existingEl.classList.contains('hidden')
                    : (status === 'success' || status === 'failed');

                var hasOutput  = output.trim().length > 0;
                var showToggle = (status === 'success' || status === 'failed') && hasOutput;

                var headerClass = 'w-full flex items-center justify-between px-3 py-2.5 transition text-left'
                    + (showToggle ? ' cursor-pointer hover:bg-white/5' : '');
                var onclickAttr = showToggle ? ' onclick="toggleTask(\'' + toggleId + '\')"' : '';

                var svgHtml = '';
                if (showToggle) {
                    var rotateCls = wasOpen ? ' rotate-180' : '';
                    svgHtml = '<svg class="toggle-arrow shrink-0 w-3.5 h-3.5 text-slate-600 transition-transform ml-2' + rotateCls + '"'
                        + ' fill="none" stroke="currentColor" viewBox="0 0 24 24">'
                        + '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>'
                        + '</svg>';
                }

                var bodyHtml = '';
                if (showToggle) {
                    var hiddenCls = wasOpen ? '' : ' hidden';
                    bodyHtml = '<div id="' + toggleId + '" class="' + hiddenCls + ' border-t border-slate-800">'
                        + '<pre class="text-[10px] text-slate-400 bg-slate-950 p-3 overflow-x-auto max-h-48 overflow-y-auto'
                        + ' font-mono whitespace-pre-wrap break-words leading-relaxed">' + escapeHtml(output) + '</pre>'
                        + '</div>';
                } else {
                    bodyHtml = '<div id="' + toggleId + '" class="hidden"></div>';
                }

                container.innerHTML += '<div class="task-row ' + rowClass + '">'
                    + '<div class="' + headerClass + '"' + onclickAttr + '>'
                    + '<div class="flex items-center gap-2.5 min-w-0">'
                    + '<span class="shrink-0 text-[9px] px-1.5 py-0.5 rounded font-bold uppercase tracking-widest ' + badgeClass + '">' + label + '</span>'
                    + '<span class="text-[11px] truncate ' + nameClass + '">' + escapeHtml(name) + '</span>'
                    + bounceDots
                    + '</div>'
                    + svgHtml
                    + '</div>'
                    + bodyHtml
                    + '</div>';
            });
        }

        function toggleTask(id) {
            var el    = document.getElementById(id);
            var btn   = el.previousElementSibling;
            var arrow = btn ? btn.querySelector('.toggle-arrow') : null;
            if (el)    el.classList.toggle('hidden');
            if (arrow) arrow.classList.toggle('rotate-180');
        }

        // ── Terminal ─────────────────────────────────────────────────────────

        function setTerminal(text) {
            var term = document.getElementById('output-terminal');
            term.textContent = text;
            term.scrollTop   = term.scrollHeight;
        }

        function appendTerminal(text) {
            var term     = document.getElementById('output-terminal');
            var atBottom = term.scrollHeight - term.scrollTop - term.clientHeight < 40;
            term.textContent += text;
            if (atBottom) term.scrollTop = term.scrollHeight;
        }

        // ── Handle SSE: status event ─────────────────────────────────────────

        function onStatus(data) {
            var task  = data.task  || '';
            var index = data.index || 0;
            var total = data.total || 0;

            if (data.task_names && data.task_names.length > 0) {
                initTasks(data.task_names);
            }

            document.getElementById('current-task').textContent  = task || '\u2014';
            document.getElementById('progress-text').textContent = index + '/' + total;

            var pct = total > 0 ? (index / total) * 100 : 0;
            document.getElementById('progress-bar').style.width = pct + '%';

            var stopBtn = document.getElementById('stop-button');
            stopBtn.classList.toggle('hidden', !data.running);
            stopBtn.classList.toggle('flex',    data.running);

            document.getElementById('status-text').textContent = data.running
                ? 'Executing instructions\u2026'
                : 'Process halted.';

            if (task && task !== currentTask) {
                if (currentTask && taskStatus[currentTask] === 'running') {
                    taskStatus[currentTask]  = 'success';
                    taskOutputs[currentTask] = liveOutput;
                }

                currentTask = task;
                liveOutput  = '';

                if (taskStatus[task] !== undefined) {
                    taskStatus[task] = 'running';
                } else {
                    taskOrder.push(task);
                    taskStatus[task]  = 'running';
                    taskOutputs[task] = '';
                }

                setTerminal('');
                renderTasks();
            }
        }

        // ── Handle SSE: log event ────────────────────────────────────────────

        function onLog(data) {
            var text = data.text || '';
            if (!text) return;
            liveOutput += text;
            appendTerminal(text);
        }

        // ── Handle SSE: done event ───────────────────────────────────────────

        function onDone(data) {
            var success  = data.success;
            var duration = data.duration || 0;
            logFile      = data.log_file || logFile;

            if (currentTask && taskStatus[currentTask] === 'running') {
                taskStatus[currentTask]  = success ? 'success' : 'failed';
                taskOutputs[currentTask] = liveOutput;
                renderTasks();
            }

            var bar = document.getElementById('progress-bar');
            bar.classList.remove('bar-running');
            bar.style.width = '100%';
            bar.classList.remove('bg-blue-500');
            bar.classList.add(success ? 'bg-emerald-500' : 'bg-rose-500');

            var dot = document.getElementById('pulse-dot');
            dot.classList.remove('bg-blue-500', 'animate-pulse');
            dot.classList.add(success ? 'bg-emerald-500' : 'bg-rose-500');

            setTerminal('');

            var banner = document.getElementById('result-banner');
            banner.classList.remove('hidden');
            var cls = success
                ? 'bg-emerald-500/10 border-emerald-500/30 text-emerald-400'
                : 'bg-rose-500/10 border-rose-500/30 text-rose-400';
            banner.className = 'p-4 rounded-lg border flex justify-between items-center text-[10px] font-bold uppercase tracking-widest ' + cls;
            var icon = success ? '\u2713 Deployment Completed' : '\u2715 Deployment Failed';
            banner.innerHTML = '<span>' + icon + '</span><span class="text-slate-500">Duration: ' + duration + 's</span>';

            var baseName = logFile.replace(/\.rlog$/, '').replace(/\.log$/, '');
            document.getElementById('action-buttons').innerHTML =
                '<a href="' + dashboardUrl + '"'
                + ' class="border border-slate-700 hover:border-slate-500 text-slate-300 px-4 py-2 rounded'
                + ' text-[10px] font-bold uppercase tracking-widest hover:text-white transition">'
                + '\u2190 Dashboard</a>'
                + '<a href="/log/rview/' + encodeURIComponent(baseName) + '"'
                + ' class="bg-slate-800 hover:bg-slate-700 text-white px-4 py-2 rounded'
                + ' text-[10px] font-bold uppercase tracking-widest transition">'
                + 'View Log \u2192</a>';

            document.getElementById('status-text').textContent = '';
            document.getElementById('status-text').classList.remove('animate-pulse');
        }

        // ── SSE connection ───────────────────────────────────────────────────

        var es         = null;
        var reconnects = 0;

        function connectSSE() {
            if (es) { es.close(); }

            es = new EventSource('/status/stream');

            es.addEventListener('status', function(e) {
                reconnects = 0;
                onStatus(JSON.parse(e.data));
            });

            es.addEventListener('log', function(e) {
                onLog(JSON.parse(e.data));
            });

            es.addEventListener('done', function(e) {
                onDone(JSON.parse(e.data));
                es.close();
            });

            es.addEventListener('wait', function() {
                document.getElementById('status-text').textContent = 'Waiting for deployment\u2026';
            });

            es.onerror = function() {
                reconnects++;
                document.getElementById('status-text').textContent =
                    'Reconnecting\u2026 (attempt ' + reconnects + ')';
            };

            es.onopen = function() {
                document.getElementById('status-text').textContent = 'Connected \u2014 streaming\u2026';
            };
        }

        // ── Stop deployment ──────────────────────────────────────────────────

        function stopDeployment() {
            if (!confirm('Stop the deployment?')) return;
            fetch('/deploy/stop', { method: 'POST' })
                .then(function(res) { return res.json(); })
                .then(function(data) {
                    if (!data.success) alert('Could not stop: ' + data.message);
                })
                .catch(function(err) { alert('Error: ' + err.message); });
        }

        // ── Bootstrap from persisted status, then connect SSE ───────────────

        function bootstrapFromStatus(data) {
            // Reconstruct task slots
            if (data.task_names && data.task_names.length > 0) {
                initTasks(data.task_names);
            }

            // Restore persisted outputs into taskOutputs
            if (data.task_outputs && typeof data.task_outputs === 'object') {
                var names = Object.keys(data.task_outputs);
                for (var n = 0; n < names.length; n++) {
                    var tname = names[n];
                    taskOutputs[tname] = data.task_outputs[tname] || '';
                }
            }

            // Restore task statuses
            if (data.task_names) {
                var currentIdx = data.index || 0;
                for (var k = 0; k < data.task_names.length; k++) {
                    var tn = data.task_names[k];
                    if (k < currentIdx - 1) {
                        taskStatus[tn] = 'success';
                    } else if (k === currentIdx - 1 && data.running) {
                        taskStatus[tn] = 'running';
                        currentTask = tn;
                        liveOutput  = taskOutputs[tn] || '';
                    } else if (k === currentIdx - 1 && !data.running) {
                        taskStatus[tn] = data.success ? 'success' : 'failed';
                    }
                    // else: remains 'pending'
                }
            }

            // Restore progress UI
            var task  = data.task  || '';
            var index = data.index || 0;
            var total = data.total || 0;
            document.getElementById('current-task').textContent  = task || '\u2014';
            document.getElementById('progress-text').textContent = index + '/' + total;
            var pct = total > 0 ? (index / total) * 100 : 0;
            document.getElementById('progress-bar').style.width  = pct + '%';

            renderTasks();

            // If already finished, call onDone to render banner + buttons
            if (data.finished) {
                onDone({
                    success:  data.success,
                    duration: data.duration || 0,
                    log_file: data.log_file || ''
                });
                return; // no SSE needed
            }

            connectSSE();
        }

        fetch('/status/data')
            .then(function(res) { return res.json(); })
            .then(function(data) { bootstrapFromStatus(data); })
            .catch(function()    { connectSSE(); }); // fallback: connect anyway
    </script>

</body>
</html>
