{**
 * Logs browser page — /alllogs
 *
 * Parameters:
 *   string $type          — active tab: log|rlog|html|fraw
 *   array  $logs          — list of log file paths (sorted newest first)
 *   string $dashboardUrl
 **}
{layout '../layout/base.latte'}
{var $title = 'Logs'}

{var $typeConfig = [
    'log'  => ['glob' => '*.log',  'url_prefix' => '/log/rview/',   'label' => 'LOG',  'desc' => 'Formatted plain text log'],
    'rlog' => ['glob' => '*.rlog', 'url_prefix' => '/log/bview/',   'label' => 'RLOG', 'desc' => 'Timestamped raw log'],
    'html' => ['glob' => '*.html', 'url_prefix' => '/log/htmlview/','label' => 'HTML', 'desc' => 'Styled HTML log'],
    'fraw' => ['glob' => '*.fraw', 'url_prefix' => '/log/frawview/','label' => 'FRAW', 'desc' => 'Full raw stream with signals'],
]}

{var $tabColors = ['log' => 'indigo', 'rlog' => 'violet', 'html' => 'sky', 'fraw' => 'amber']}

{block content}
<div class="max-w-6xl mx-auto">

    {* Header *}
    <div class="flex justify-between items-start mb-8">
        <div>
            <a href="/"><h1 class="text-slate-900 dark:text-white font-bold text-xl tracking-tighter uppercase">SIMPLE PHP <span class="text-[#a855f7]">DEPLOYER</span></h1></a>
            <p class="text-slate-400 dark:text-slate-500">Execution Logs</p>
        </div>
        <a href="{$dashboardUrl|escape}" class="text-xs text-indigo-600 dark:text-indigo-400 hover:underline font-bold uppercase tracking-tighter">← Dashboard</a>
    </div>

    <div class="bg-white dark:bg-[#161b2a] border border-slate-200 dark:border-slate-800 rounded-lg shadow-sm dark:shadow-xl overflow-hidden">

        {* Tabs *}
        <div class="flex border-b border-slate-200 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-900/30">
            {foreach $typeConfig as $key => $cfg}
                {var $active = ($key === $type)}
                {var $color = $tabColors[$key]}
                {if $active}
                    {var $tabClass = "border-b-2 border-{$color}-500 text-{$color}-600 dark:text-{$color}-400 bg-white dark:bg-[#161b2a]"}
                {else}
                    {var $tabClass = 'text-slate-400 dark:text-slate-500 hover:text-slate-600 dark:hover:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800/40'}
                {/if}
                <a href="/alllogs?type={$key}"
                   class="px-6 py-3 text-[10px] font-bold uppercase tracking-widest transition {$tabClass}">
                    {$cfg['label']}
                    {if $active}<span class="ml-1.5 text-[9px] opacity-60">{$cfg['desc']}</span>{/if}
                </a>
            {/foreach}
        </div>

        {* Table *}
        <div class="overflow-x-auto">
            {if !$logs}
                <div class="p-16 text-center text-slate-400 dark:text-slate-600 italic text-sm">
                    No {$type|upper} logs found.
                </div>
            {else}
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="bg-slate-50 dark:bg-slate-900/50 text-slate-400 dark:text-slate-500 text-[10px] uppercase">
                            <th class="px-6 py-3 font-bold border-b border-slate-100 dark:border-slate-800">File</th>
                            <th class="px-6 py-3 font-bold border-b border-slate-100 dark:border-slate-800">Date</th>
                            <th class="px-6 py-3 font-bold border-b border-slate-100 dark:border-slate-800 text-right">Size</th>
                            <th class="px-6 py-3 font-bold border-b border-slate-100 dark:border-slate-800 text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
                        {foreach $logs as $logPath}
                            {var $fn    = basename($logPath)}
                            {var $id    = preg_replace('/\.log.*$/', '', $fn)}
                            {var $color = $tabColors[$type]}
                            {var $viewUrl = $typeConfig[$type]['url_prefix'] . urlencode($id)}
                            <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/20 transition">
                                <td class="px-6 py-4 text-xs">
                                    {include '../partials/log-status-badge.latte', status: $logStatuses[$logPath] ?? null}
                                    {$fn|escape}
                                </td>
                                <td class="px-6 py-4 text-slate-400 dark:text-slate-600 text-xs">
                                    {date('Y-m-d H:i:s', filemtime($logPath))}
                                </td>
                                <td class="px-6 py-4 text-slate-400 dark:text-slate-600 text-xs text-right tabular-nums">
                                    {$logSizes[$logPath]}
                                </td>
                                <td class="px-6 py-4 text-right">
                                    <a target="_blank" href="{$viewUrl|escape}"
                                       class="inline-block px-3 py-1 rounded text-[10px] font-bold uppercase tracking-wide bg-{$color}-500/10 text-{$color}-600 dark:text-{$color}-400 hover:bg-{$color}-500/20 transition">
                                        OPEN
                                    </a>
                                </td>
                            </tr>
                        {/foreach}
                    </tbody>
                </table>
            {/if}
        </div>

        {* Footer *}
        <div class="px-6 py-3 border-t border-slate-100 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-900/30 text-[10px] text-slate-400 dark:text-slate-600 flex justify-between">
            <span>{count($logs)} file(s) found</span>
            <span>{$typeConfig[$type]['desc']}</span>
        </div>
    </div>

</div>
{/block}
